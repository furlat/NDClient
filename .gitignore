# External/private artwork and derived render data stay local.
/.media/
/assets/*
# The Factory's VFX package: its scripts, shaders, text resources and index are
# versioned here; its binary resources (recordings, meshes, textures, warmed
# materials) are stored outside git, per package version.
!/assets/vfx/
# Data measured from the art (sockets, ground lines, trails, palette ranges):
# small text resources the presentation sources refer to, kept in git.
!/assets/measured/
/assets/vfx/**/*.res
/assets/vfx/**/*.scn
# Godot writes .uid files beside the package's scripts on import; the package
# is kept exactly as the Factory exported it.
/assets/vfx/**/*.uid
/.derived/
/.reference-template/
*.png
*.PNG
*.jpg
*.jpeg
*.webp
*.gif
*.wav
*.ogg
*.mp3
*.flac
*.mp4
*.webm
*.mov
*.blend
*.blend1
*.psd
*.aseprite
*.exr
*.hdr
*.ktx
*.ktx2
*.dds
*.glb
*.fbx
*.zip

# Native imports, private encounters, captures and disposable profiles.
/.godot/
/.runtime/
/.captures/
/generated/render_cache/
/generated/receiving_normals/
/generated/profiles/
# New diagnostic reports are disposable; curated reference inputs live under
# tests/fixtures/schema16. Existing versioned files remain tracked.
/generated/
# Former live-test reports; the tests now write them beside their run.
/generated/player_startup_checks.json
/generated/live_idle_ui_checks.json
__pycache__/
*.py[cod]
.pytest_cache/
.venv/

# Presentation build output (tools/build_presentation.gd); rebuilt, never edited.
/build/
# Reproducible current-schema test inputs are source data. Other ad-hoc fixture
# exports remain local; artwork/imports still obey the binary rules above.
/tests/fixtures/*
!/tests/fixtures/schema16/
!/tests/fixtures/schema16/spool-oracle/canonical-states.zip

# Small typed staging source shared by dynamic item-effect ownership tests.
!/tests/fixtures/dynamic_weapon_overlay.tres
