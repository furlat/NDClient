# External/private artwork and derived render data stay local.
/.media/
/assets/*
# The Factory's VFX package: its scripts, shaders, text resources and index are
# versioned here; its binary resources (recordings, meshes, textures, warmed
# materials) are stored outside git, per package version.
!/assets/vfx/
/assets/vfx/**/*.res
/assets/vfx/**/*.scn
/.derived/
/.reference-template/
*.png
*.PNG
*.jpg
*.jpeg
*.webp
*.gif
*.wav
*.ogg
*.mp3
*.flac
*.mp4
*.webm
*.mov
*.blend
*.blend1
*.psd
*.aseprite
*.exr
*.hdr
*.ktx
*.ktx2
*.dds
*.glb
*.fbx
*.zip

# Native imports, private encounters, captures and disposable profiles.
/.godot/
/.runtime/
/.captures/
/generated/render_cache/
/generated/receiving_normals/
/generated/profiles/
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
