[sub_resource type="Shader" id="Shader_1ryry"]
code = "shader_type spatial;
global uniform sampler2D vfx_package_clock;
uniform int vfx_package_clock_slot=0;
float vfx_package_seconds(){return texelFetch(vfx_package_clock,ivec2(vfx_package_clock_slot,0),0).r;}
uniform float vfx_package_offset_receiving_clock=0.0;

uniform float receiving_clock=0.0;
uniform float receiving_envelope=0.0;
uniform float receiving_opacity=1.0;

render_mode unshaded;

group_uniforms Color;
uniform vec3 primary_color : source_color = vec3(1.0,0.8,0.2);
uniform vec3 secondary_color : source_color = vec3(1.0,0.4,0.1);
uniform vec3 tertiary_color : source_color = vec3(0.6,0.1,0.05);
uniform float emission = 2.0;
uniform float color_curve = 1.0;
uniform float hue_variation = 0.1;
uniform bool use_secondary = false;

group_uniforms Shape;
uniform sampler2D noise_texture;
uniform vec2 noise_scale = vec2(0.5);
uniform vec2 noise_scroll = vec2(0.0, 0.1);
uniform float shape_curve = 2.0;
uniform float noise_twist : hint_range(-1.0, 1.0, 0.05) = 0.0;
uniform float waviness : hint_range(0.0, 1.0, 0.01) = 0.2;

group_uniforms Transparency;
uniform float edge_hardness : hint_range(0.0, 1.0, 0.01) = 0.0;
uniform float edge_position : hint_range(0.0, 1.0, 0.01) = 0.0;
uniform bool proximity_fade = false;
uniform float proximity_fade_distance : hint_range(0.0, 4096.0, 0.01);
uniform sampler2D depth_texture : hint_depth_texture, repeat_disable, filter_nearest;

vec3 shift_hue(vec3 color, float shift) {
	vec3 gray = vec3(0.57735);
	vec3 projection = gray * dot(gray, color.rgb);
	vec3 U = color.rgb - projection;
	vec3 V = cross(gray, U);
	vec3 shifted = U * cos(shift * 2.0 * PI) + V * sin(shift * 2.0 * PI) + projection;
	return shifted;
}

uniform sampler2D gpu_body_points : filter_nearest, repeat_disable;
uniform int gpu_body_count = 0;
uniform int gpu_form_profile = 0;
uniform bool gpu_form_readable = false;
uniform vec3 gpu_body_up = vec3(0., 1., 0.);
uniform vec3 gpu_body_side = vec3(1., 0., 0.);
uniform vec2 gpu_body_radii = vec2(.1);
uniform float gpu_form_phase = 0.;
uniform float gpu_form_heading_bias=0.;
uniform float gpu_form_width = .02;
uniform float gpu_form_camber = .01;

vec3 patch_frame_up(){return texelFetch(gpu_body_points,ivec2(0,2),0).xyz;}
vec3 patch_frame_side(){return texelFetch(gpu_body_points,ivec2(1,2),0).xyz;}
vec2 patch_frame_radii(){return texelFetch(gpu_body_points,ivec2(2,2),0).xy;}
float patch_frame_valid(){return texelFetch(gpu_body_points,ivec2(3,2),0).x;}
void gpu_body_support(float along, float across, out vec3 position, out vec3 normal) {
	vec4 best = vec4(1e30);
	ivec4 nearest = ivec4(0);
	for (int index = 0; index < gpu_body_count; index++) {
		vec3 point = texelFetch(gpu_body_points, ivec2(index, 0), 0).xyz;
		vec2 delta = vec2(dot(point, patch_frame_up()) - along, dot(point, patch_frame_side()) - across);
		float distance = dot(delta, delta);
		if (distance < best.w) {
			int slot = 3;
			for (int candidate = 0; candidate < 3; candidate++) {
				if (distance < best[candidate]) { slot = candidate; break; }
			}
			for (int candidate = 3; candidate > slot; candidate--) {
				best[candidate] = best[candidate - 1];
				nearest[candidate] = nearest[candidate - 1];
			}
			best[slot] = distance;
			nearest[slot] = index;
		}
	}
	position = vec3(0.);
	normal = vec3(0.);
	float total = 0.;
	for (int candidate = 0; candidate < 4; candidate++) {
		float weight = 1. / (best[candidate] + .00015);
		position += texelFetch(gpu_body_points, ivec2(nearest[candidate], 0), 0).xyz * weight;
		normal += texelFetch(gpu_body_points, ivec2(nearest[candidate], 1), 0).xyz * weight;
		total += weight;
	}
	position /= total;
	normal = normalize(normal);
	
}

void gpu_form_station(int station,int piece_index,out vec3 position,out vec3 normal,out float width){
	float u=float(station)/32.;float number=float(piece_index);float sign_value=piece_index%2==0 ? -1. : 1.;
	float phase=gpu_form_phase+number*1.9;
	float along;float across;float clearance;
	if(gpu_form_profile==0){
		along=(u-.5)*min(patch_frame_radii().x*1.1,.29)+.06*sin(phase*.6);
		across=sign_value*patch_frame_radii().y*(.55+.16*sin(u*3.14159265359));
		clearance=.045+.04*sin(u*3.14159265359)+.015*sin(phase);
	}else{
		along=(u-.5)*min(patch_frame_radii().x*1.35,.44);
		across=sign_value*patch_frame_radii().y*.55+.025*sin(u*6.28318530718+phase);
		clearance=.045+.035*sin(u*6.28318530718*1.5-phase);
	}
	gpu_body_support(along,across,position,normal);
	position+=normal*clearance;
	width=gpu_form_width*pow(max(0.,sin(u*3.14159265359)),.8);
}

void gpu_directed_vertex(inout vec3 point, inout vec3 normal, inout vec3 tangent, inout vec3 binormal) {
if(patch_frame_valid()<.5){point=vec3(0.);normal=vec3(0.,1.,0.);return;}

	int station = int(point.x + .5);
	int piece_index = int(point.z + .5);
	float edge = point.y;
	vec3 position;
	vec3 before;
	vec3 after;
	vec3 source_normal;
	vec3 ignored_normal;
	float width;
	float ignored_width;
	gpu_form_station(station, piece_index, position, source_normal, width);
	gpu_form_station(max(0, station - 1), piece_index, before, ignored_normal, ignored_width);
	gpu_form_station(min(32, station + 1), piece_index, after, ignored_normal, ignored_width);
	vec3 direction = normalize(after - before);
	vec3 across = patch_frame_side();
	point = position + across * edge * width + source_normal * (1. - edge * edge) * gpu_form_camber * sin(float(station) / 32. * 3.14159265359);
	normal = normalize(cross(across, direction));
}

void vertex() {gpu_directed_vertex(VERTEX,NORMAL,TANGENT,BINORMAL);}
void fragment() {
	float r = length(UV * 2.0 - 1.0);
	
	vec2 noise_uv = (vec2(UV.x + UV.y * noise_twist, UV.y) + COLOR.r) * noise_scale + (noise_scroll * (vfx_package_seconds()+vfx_package_offset_receiving_clock));
	
	float wave = sin(UV.y * 20.0 + (vfx_package_seconds()+vfx_package_offset_receiving_clock) * 6.0);
	noise_uv.x += wave * 0.1 * waviness;
	
	float noise = texture(noise_texture, noise_uv).r;
	
	float value = pow(max(noise - r, 0.0), shape_curve) * COLOR.a;
	
	float color_value = pow(value, color_curve);
	color_value = mix(color_value, floor(color_value * 6.0) / 5.0, edge_hardness);
	vec3 main_color = use_secondary ? secondary_color : primary_color;
	vec3 color = mix(tertiary_color, main_color, color_value);
	color = shift_hue(color, (COLOR.r - 0.5) * hue_variation) * (0.5 + COLOR.r * 0.5);
	
	ALBEDO = color * emission;
	ALPHA = value;
	
	// Proximity Fade: Enabled
	if(proximity_fade){
		float proximity_depth_tex = textureLod(depth_texture, SCREEN_UV, 0.0).r;
		vec4 ndc = OUTPUT_IS_SRGB ? vec4(vec3(SCREEN_UV, proximity_depth_tex) * 2.0 - 1.0, 1.0) : vec4(SCREEN_UV * 2.0 - 1.0, proximity_depth_tex, 1.0);
		vec4 proximity_view_pos = INV_PROJECTION_MATRIX * ndc;
		proximity_view_pos.xyz /= proximity_view_pos.w;
		ALPHA *= clamp(1.0 - smoothstep(proximity_view_pos.z + proximity_fade_distance, proximity_view_pos.z, VERTEX.z), 0.0, 1.0);
	}
	
	ALPHA = clamp((ALPHA - edge_position) / (1.0 - edge_hardness), 0.0, 1.0);

ALPHA=pow(clamp(ALPHA,0.0,1.0),1.0);
ALPHA*=receiving_envelope*receiving_opacity*0.55;

ALPHA*=patch_frame_valid();
}
"

[sub_resource type="Shader" id="Shader_nkqw5"]
code = "shader_type spatial;
global uniform sampler2D vfx_package_clock;
uniform int vfx_package_clock_slot=0;
float vfx_package_seconds(){return texelFetch(vfx_package_clock,ivec2(vfx_package_clock_slot,0),0).r;}
uniform float vfx_package_offset_receiving_clock=0.0;

uniform float receiving_clock=0.0;
uniform float receiving_envelope=0.0;
uniform float receiving_opacity=1.0;

render_mode unshaded, cull_disabled;

uniform sampler2D icon_texture;

group_uniforms Color;
uniform vec3 primary_color : source_color = vec3(1.0,0.8,0.2);
uniform vec3 secondary_color : source_color = vec3(1.0,0.4,0.1);
uniform float emission = 2.0;
uniform float color_curve = 1.0;
uniform float hue_variation = 0.1;

group_uniforms Transparency;
uniform float edge_hardness : hint_range(0.0, 1.0, 0.01) = 0.0;
uniform float edge_position : hint_range(0.0, 1.0, 0.01) = 0.2;
uniform bool proximity_fade = false;
uniform float proximity_fade_distance : hint_range(0.0, 4096.0, 0.01);
uniform sampler2D depth_texture : hint_depth_texture, repeat_disable, filter_nearest;

varying flat int id;

vec3 shift_hue(vec3 color, float shift) {
	vec3 gray = vec3(0.57735);
	vec3 projection = gray * dot(gray, color.rgb);
	vec3 U = color.rgb - projection;
	vec3 V = cross(gray, U);
	vec3 shifted = U * cos(shift * 2.0 * PI) + V * sin(shift * 2.0 * PI) + projection;
	return shifted;
}

uniform sampler2D gpu_body_points : filter_nearest, repeat_disable;
uniform int gpu_body_count = 0;
uniform int gpu_form_profile = 0;
uniform bool gpu_form_readable = false;
uniform vec3 gpu_body_up = vec3(0., 1., 0.);
uniform vec3 gpu_body_side = vec3(1., 0., 0.);
uniform vec2 gpu_body_radii = vec2(.1);
uniform float gpu_form_phase = 0.;
uniform float gpu_form_heading_bias=0.;
uniform float gpu_form_width = .02;
uniform float gpu_form_camber = .01;

vec3 patch_frame_up(){return texelFetch(gpu_body_points,ivec2(0,2),0).xyz;}
vec3 patch_frame_side(){return texelFetch(gpu_body_points,ivec2(1,2),0).xyz;}
vec2 patch_frame_radii(){return texelFetch(gpu_body_points,ivec2(2,2),0).xy;}
float patch_frame_valid(){return texelFetch(gpu_body_points,ivec2(3,2),0).x;}
void gpu_body_support(float along, float across, out vec3 position, out vec3 normal) {
	vec4 best = vec4(1e30);
	ivec4 nearest = ivec4(0);
	for (int index = 0; index < gpu_body_count; index++) {
		vec3 point = texelFetch(gpu_body_points, ivec2(index, 0), 0).xyz;
		vec2 delta = vec2(dot(point, patch_frame_up()) - along, dot(point, patch_frame_side()) - across);
		float distance = dot(delta, delta);
		if (distance < best.w) {
			int slot = 3;
			for (int candidate = 0; candidate < 3; candidate++) {
				if (distance < best[candidate]) { slot = candidate; break; }
			}
			for (int candidate = 3; candidate > slot; candidate--) {
				best[candidate] = best[candidate - 1];
				nearest[candidate] = nearest[candidate - 1];
			}
			best[slot] = distance;
			nearest[slot] = index;
		}
	}
	position = vec3(0.);
	normal = vec3(0.);
	float total = 0.;
	for (int candidate = 0; candidate < 4; candidate++) {
		float weight = 1. / (best[candidate] + .00015);
		position += texelFetch(gpu_body_points, ivec2(nearest[candidate], 0), 0).xyz * weight;
		normal += texelFetch(gpu_body_points, ivec2(nearest[candidate], 1), 0).xyz * weight;
		total += weight;
	}
	position /= total;
	normal = normalize(normal);
	
}

void gpu_form_station(int station,int piece_index,out vec3 position,out vec3 normal,out float width){
	float u=float(station)/32.;float number=float(piece_index);float sign_value=piece_index%2==0 ? -1. : 1.;
	float phase=gpu_form_phase+number*1.9;
	float along;float across;float clearance;
	if(gpu_form_profile==0){
		along=(u-.5)*min(patch_frame_radii().x*1.1,.29)+.06*sin(phase*.6);
		across=sign_value*patch_frame_radii().y*(.55+.16*sin(u*3.14159265359));
		clearance=.045+.04*sin(u*3.14159265359)+.015*sin(phase);
	}else{
		along=(u-.5)*min(patch_frame_radii().x*1.35,.44);
		across=sign_value*patch_frame_radii().y*.55+.025*sin(u*6.28318530718+phase);
		clearance=.045+.035*sin(u*6.28318530718*1.5-phase);
	}
	gpu_body_support(along,across,position,normal);
	position+=normal*clearance;
	width=gpu_form_width*pow(max(0.,sin(u*3.14159265359)),.8);
}

void gpu_directed_vertex(inout vec3 point, inout vec3 normal, inout vec3 tangent, inout vec3 binormal) {
if(patch_frame_valid()<.5){point=vec3(0.);normal=vec3(0.,1.,0.);return;}

	int station = int(point.x + .5);
	int piece_index = int(point.z + .5);
	float edge = point.y;
	vec3 position;
	vec3 before;
	vec3 after;
	vec3 source_normal;
	vec3 ignored_normal;
	float width;
	float ignored_width;
	gpu_form_station(station, piece_index, position, source_normal, width);
	gpu_form_station(max(0, station - 1), piece_index, before, ignored_normal, ignored_width);
	gpu_form_station(min(32, station + 1), piece_index, after, ignored_normal, ignored_width);
	vec3 direction = normalize(after - before);
	vec3 across = patch_frame_side();
	point = position + across * edge * width + source_normal * (1. - edge * edge) * gpu_form_camber * sin(float(station) / 32. * 3.14159265359);
	normal = normalize(cross(across, direction));
}

void vertex() {gpu_directed_vertex(VERTEX,NORMAL,TANGENT,BINORMAL);
	id = INSTANCE_ID;
}

void fragment() {
	vec2 icon = texture(icon_texture, UV).ra;
	
	float shape = icon.y;
	
	ALPHA = shape;
	
	vec3 color = mix(secondary_color, primary_color, icon.x);
	color = shift_hue(color, (COLOR.r - 0.5) * hue_variation);
	
	ALBEDO = color * emission;
	
	
	// Proximity Fade: Enabled
	if(proximity_fade){
		float proximity_depth_tex = textureLod(depth_texture, SCREEN_UV, 0.0).r;
		vec4 ndc = OUTPUT_IS_SRGB ? vec4(vec3(SCREEN_UV, proximity_depth_tex) * 2.0 - 1.0, 1.0) : vec4(SCREEN_UV * 2.0 - 1.0, proximity_depth_tex, 1.0);
		vec4 proximity_view_pos = INV_PROJECTION_MATRIX * ndc;
		proximity_view_pos.xyz /= proximity_view_pos.w;
		ALPHA *= clamp(1.0 - smoothstep(proximity_view_pos.z + proximity_fade_distance, proximity_view_pos.z, VERTEX.z), 0.0, 1.0);
	}
	
	ALPHA = clamp((ALPHA - edge_position) / (1.0 - edge_hardness), 0.0, 1.0);

ALPHA=pow(clamp(ALPHA,0.0,1.0),1.0);
ALPHA*=receiving_envelope*receiving_opacity*0.65;

ALPHA*=patch_frame_valid();
}
