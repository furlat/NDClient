code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_lambert, specular_schlick_ggx, unshaded;

uniform vec2 Dist_Speed;
uniform sampler2D Distortion_tex : source_color;
uniform float Distortion_Divide = 0.10000000149012;
uniform sampler2D tex : source_color;
uniform sampler2D tex_frg_21 : source_color;
uniform sampler2D curve_frg_23 : repeat_disable;



void vertex() {
	mat4 n_out2p0;
// GetBillboardMatrix:2
	{
		mat4 __wm = mat4(normalize(INV_VIEW_MATRIX[0]), normalize(INV_VIEW_MATRIX[1]), normalize(INV_VIEW_MATRIX[2]), MODEL_MATRIX[3]);
		__wm = __wm * mat4(vec4(cos(INSTANCE_CUSTOM.x), -sin(INSTANCE_CUSTOM.x), 0.0, 0.0), vec4(sin(INSTANCE_CUSTOM.x), cos(INSTANCE_CUSTOM.x), 0.0, 0.0), vec4(0.0, 0.0, 1.0, 0.0), vec4(0.0, 0.0, 0.0, 1.0));
		__wm = __wm * mat4(vec4(length(MODEL_MATRIX[0].xyz), 0.0, 0.0, 0.0), vec4(0.0, length(MODEL_MATRIX[1].xyz), 0.0, 0.0), vec4(0.0, 0.0, length(MODEL_MATRIX[2].xyz), 0.0), vec4(0.0, 0.0, 0.0, 1.0));
		n_out2p0 = VIEW_MATRIX * __wm;
	}


// Output:0
	MODELVIEW_MATRIX = n_out2p0;


}

void fragment() {
// Input:7
	vec4 n_out7p0 = COLOR;
	float n_out7p1 = n_out7p0.r;


	float n_out10p0;
// Remap:10
	float n_in10p1 = 0.00000;
	float n_in10p2 = 1.00000;
	float n_in10p3 = 0.00000;
	float n_in10p4 = 0.80000;
	{
		float __input_range = n_in10p2 - n_in10p1;
		float __output_range = n_in10p4 - n_in10p3;
		n_out10p0 = n_in10p3 + __output_range * ((n_out7p1 - n_in10p1) / __input_range);
	}


// Input:11
	vec2 n_out11p0 = UV;


// Input:16
	float n_out16p0 = TIME;


// Vector2Parameter:18
	vec2 n_out18p0 = Dist_Speed;


// VectorOp:17
	vec2 n_out17p0 = vec2(n_out16p0) * n_out18p0;


// UVFunc:13
	vec2 n_in13p1 = vec2(1.00000, 1.00000);
	vec2 n_out13p0 = n_out17p0 * n_in13p1 + UV;


	vec4 n_out15p0;
// Texture2D:15
	n_out15p0 = texture(Distortion_tex, n_out13p0);


// FloatParameter:20
	float n_out20p0 = Distortion_Divide;


// FloatOp:19
	float n_out19p0 = n_out15p0.x / n_out20p0;


// VectorOp:12
	vec2 n_out12p0 = n_out11p0 + vec2(n_out19p0);


	vec4 n_out3p0;
// Texture2D:3
	n_out3p0 = texture(tex, n_out12p0);
	float n_out3p1 = n_out3p0.r;


// SmoothStep:9
	float n_in9p1 = 0.80000;
	float n_out9p0 = smoothstep(n_out10p0, n_in9p1, n_out3p1);


// Texture2D:21
	vec4 n_out21p0 = texture(tex_frg_21, vec2(n_out9p0));


// CurveTexture:23
	float n_out23p0 = texture(curve_frg_23, vec2(n_out7p1)).r;


// FloatOp:22
	float n_out22p0 = n_out9p0 * n_out23p0;


// Output:0
	ALBEDO = vec3(n_out21p0.xyz);
	ALPHA = n_out22p0;


}
"
