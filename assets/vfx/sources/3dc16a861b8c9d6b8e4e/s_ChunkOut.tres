code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_disabled, diffuse_lambert, specular_schlick_ggx, unshaded;

uniform vec4 ColorParameter : source_color = vec4(1.000000, 1.000000, 1.000000, 1.000000);
uniform vec2 speed = vec2(0.000000, -1.000000);
uniform sampler2D Texture2DParameter;
uniform sampler2D tex_frg_13;



void fragment() {
// ColorParameter:15
	vec4 n_out15p0 = ColorParameter;
	float n_out15p4 = n_out15p0.a;


// Input:14
	vec4 n_out14p0 = COLOR;
	float n_out14p1 = n_out14p0.r;


// Vector2Parameter:22
	vec2 n_out22p0 = speed;


// VectorOp:18
	vec2 n_out18p0 = vec2(n_out14p1) * n_out22p0;


// UVFunc:8
	vec2 n_in8p1 = vec2(1.00000, 1.00000);
	vec2 n_out8p0 = n_out18p0 * n_in8p1 + UV;


	vec4 n_out21p0;
// Texture2D:21
	n_out21p0 = texture(Texture2DParameter, n_out8p0);
	float n_out21p1 = n_out21p0.r;


// VectorOp:19
	vec4 n_out19p0 = n_out15p0 * n_out21p0;


// Texture2D:13
	vec4 n_out13p0 = texture(tex_frg_13, UV);
	float n_out13p1 = n_out13p0.r;


// FloatOp:12
	float n_out12p0 = n_out21p1 * n_out13p1;


// FloatOp:16
	float n_out16p0 = n_out15p4 * n_out12p0;


// Output:0
	ALBEDO = vec3(n_out19p0.xyz);
	ALPHA = n_out16p0;


}
"
