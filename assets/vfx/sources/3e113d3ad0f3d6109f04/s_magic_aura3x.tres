code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_lambert, specular_schlick_ggx, unshaded;

uniform float SPEED_Big_Line;
uniform sampler2D Line_Thunder;
uniform vec4 Aura_Color : source_color;
uniform float Arua_Power = 8;
uniform float fresnel = 0;
uniform vec2 Aura_Divide = vec2(1.000000, 1.000000);
uniform vec2 Speed_small_details;
uniform sampler2D Distortion_Texture : source_color;
uniform sampler2D Aura_Texture : source_color;
uniform bool Has_mask;
uniform sampler2D Mask : source_color;



void vertex() {
// Input:2
	vec3 n_out2p0 = VERTEX;


// Input:4
	vec3 n_out4p0 = NORMAL;


// Input:8
	float n_out8p0 = TIME;


// FloatParameter:16
	float n_out16p0 = SPEED_Big_Line;


// VectorCompose:17
	float n_in17p0 = 0.00000;
	vec2 n_out17p0 = vec2(n_in17p0, n_out16p0);


// VectorOp:9
	vec2 n_out9p0 = vec2(n_out8p0) * n_out17p0;


// UVFunc:13
	vec2 n_in13p1 = vec2(1.00000, 1.00000);
	vec2 n_out13p0 = n_out9p0 * n_in13p1 + UV;


	vec4 n_out19p0;
// Texture2D:19
	n_out19p0 = texture(Line_Thunder, n_out13p0);


// FloatConstant:15
	float n_out15p0 = 0.100000;


// VectorOp:14
	vec4 n_out14p0 = n_out19p0 + vec4(n_out15p0);


// VectorOp:5
	vec3 n_out5p0 = n_out4p0 * vec3(n_out14p0.xyz);


// FloatConstant:6
	float n_out6p0 = 0.015000;


// VectorOp:11
	vec3 n_out11p0 = n_out5p0 * vec3(n_out6p0);


// VectorOp:3
	vec3 n_out3p0 = n_out2p0 + n_out11p0;


// Output:0
	VERTEX = n_out3p0;


}

void fragment() {
// ColorParameter:9
	vec4 n_out9p0 = Aura_Color;


// FloatParameter:14
	float n_out14p0 = Arua_Power;


// VectorOp:13
	vec4 n_out13p0 = n_out9p0 * vec4(n_out14p0);


// Input:36
	float n_out36p0 = TIME;


// ParameterRef:51
	float n_out51p0 = SPEED_Big_Line;


// VectorCompose:52
	float n_in52p0 = 0.00000;
	vec2 n_out52p0 = vec2(n_in52p0, n_out51p0);


// VectorOp:39
	vec2 n_out39p0 = vec2(n_out36p0) * n_out52p0;


// UVFunc:40
	vec2 n_in40p1 = vec2(1.00000, 1.00000);
	vec2 n_out40p0 = n_out39p0 * n_in40p1 + UV;


	vec4 n_out54p0;
// Texture2D:54
	n_out54p0 = texture(Line_Thunder, n_out40p0);


// VectorOp:41
	vec4 n_out41p0 = n_out13p0 * n_out54p0;


// FloatConstant:44
	float n_out44p0 = 3.000000;


// VectorOp:43
	vec4 n_out43p0 = n_out41p0 * vec4(n_out44p0);


// Fresnel:26
	float n_in26p3 = 0.50000;
	float n_out26p0 = pow(1.0 - clamp(dot(NORMAL, VIEW), 0.0, 1.0), n_in26p3);


// VectorOp:27
	vec4 n_out27p0 = n_out13p0 * vec4(n_out26p0);


// VectorOp:42
	vec4 n_out42p0 = n_out43p0 + n_out27p0;


// FloatParameter:25
	float n_out25p0 = fresnel;


// Fresnel:23
	float n_out23p0 = pow(1.0 - clamp(dot(NORMAL, VIEW), 0.0, 1.0), n_out25p0);


// Input:46
	float n_out46p0 = TIME;


// FloatOp:49
	float n_in49p1 = 15.00000;
	float n_out49p0 = n_out46p0 * n_in49p1;


// FloatFunc:47
	float n_out47p0 = sin(n_out49p0);


	float n_out48p0;
// Remap:48
	float n_in48p1 = -1.00000;
	float n_in48p2 = 1.00000;
	float n_in48p3 = 0.00000;
	float n_in48p4 = 0.50000;
	{
		float __input_range = n_in48p2 - n_in48p1;
		float __output_range = n_in48p4 - n_in48p3;
		n_out48p0 = n_in48p3 + __output_range * ((n_out47p0 - n_in48p1) / __input_range);
	}


// Input:22
	vec2 n_out22p0 = UV;


// Vector2Parameter:21
	vec2 n_out21p0 = Aura_Divide;


// VectorOp:20
	vec2 n_out20p0 = n_out22p0 / n_out21p0;


// Input:5
	float n_out5p0 = TIME;


// Vector2Parameter:12
	vec2 n_out12p0 = Speed_small_details;


// VectorOp:6
	vec2 n_out6p0 = vec2(n_out5p0) * n_out12p0;


// UVFunc:4
	vec2 n_in4p1 = vec2(1.00000, 1.00000);
	vec2 n_out4p0 = n_out6p0 * n_in4p1 + n_out20p0;


	vec4 n_out35p0;
// Texture2D:35
	n_out35p0 = texture(Distortion_Texture, n_out4p0);
	float n_out35p1 = n_out35p0.r;


// FloatOp:33
	float n_in33p1 = 5.00000;
	float n_out33p0 = n_out35p1 / n_in33p1;


// Input:32
	vec2 n_out32p0 = UV;


// VectorOp:31
	vec2 n_out31p0 = vec2(n_out33p0) + n_out32p0;


	vec4 n_out8p0;
// Texture2D:8
	n_out8p0 = texture(Aura_Texture, n_out31p0);
	float n_out8p1 = n_out8p0.r;


// FloatOp:50
	float n_in50p1 = 0.50000;
	float n_out50p0 = pow(n_out8p1, n_in50p1);


// SmoothStep:45
	float n_in45p1 = 0.80000;
	float n_out45p0 = smoothstep(n_out48p0, n_in45p1, n_out50p0);


// FloatOp:24
	float n_out24p0 = n_out23p0 * n_out45p0;


// BooleanParameter:18
	bool n_out18p0 = Has_mask;


	vec4 n_out16p0;
// Texture2D:16
	n_out16p0 = texture(Mask, UV);
	float n_out16p3 = n_out16p0.b;


// FloatConstant:19
	float n_out19p0 = 1.000000;


	bool n_out17p0;
// Switch:17
	if (n_out18p0) {
		n_out17p0 = n_out16p3 > 0.0 ? true : false;
	} else {
		n_out17p0 = n_out19p0 > 0.0 ? true : false;
	}


// FloatOp:11
	float n_out11p0 = n_out24p0 * (n_out17p0 ? 1.0 : 0.0);


// Fresnel:28
	float n_in28p3 = 10.00000;
	float n_out28p0 = pow(1.0 - clamp(dot(NORMAL, VIEW), 0.0, 1.0), n_in28p3);


// FloatOp:29
	float n_out29p0 = n_out11p0 + n_out28p0;


// Output:0
	ALBEDO = vec3(n_out42p0.xyz);
	ALPHA = n_out29p0;


}
