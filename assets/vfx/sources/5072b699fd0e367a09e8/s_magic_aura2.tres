[resource]
code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_lambert, specular_schlick_ggx, unshaded;

uniform vec4 Aura_Color : source_color;
uniform float Arua_Power = 8;
uniform float fresnel = 0;
uniform vec2 Aura_Divide = vec2(1.000000, 1.000000);
uniform vec2 Speed;
uniform sampler2D Aura_Texture : source_color;
uniform bool Has_mask;
uniform sampler2D Mask : source_color;



void fragment() {
// ColorParameter:9
	vec4 n_out9p0 = Aura_Color;


// FloatParameter:14
	float n_out14p0 = Arua_Power;


// VectorOp:13
	vec4 n_out13p0 = n_out9p0 * vec4(n_out14p0);


// Fresnel:26
	float n_in26p3 = 0.20000;
	float n_out26p0 = pow(1.0 - clamp(dot(NORMAL, VIEW), 0.0, 1.0), n_in26p3);


// VectorOp:27
	vec4 n_out27p0 = n_out13p0 * vec4(n_out26p0);


// FloatParameter:25
	float n_out25p0 = fresnel;


// Fresnel:23
	float n_out23p0 = pow(1.0 - clamp(dot(NORMAL, VIEW), 0.0, 1.0), n_out25p0);


// Input:22
	vec2 n_out22p0 = UV;


// Vector2Parameter:21
	vec2 n_out21p0 = Aura_Divide;


// VectorOp:20
	vec2 n_out20p0 = n_out22p0 / n_out21p0;


// Input:5
	float n_out5p0 = TIME;


// Vector2Parameter:12
	vec2 n_out12p0 = Speed;


// VectorOp:6
	vec2 n_out6p0 = vec2(n_out5p0) * n_out12p0;


// UVFunc:4
	vec2 n_in4p1 = vec2(1.00000, 1.00000);
	vec2 n_out4p0 = n_out6p0 * n_in4p1 + n_out20p0;


	vec4 n_out8p0;
// Texture2D:8
	n_out8p0 = texture(Aura_Texture, n_out4p0);
	float n_out8p1 = n_out8p0.r;


// FloatOp:24
	float n_out24p0 = n_out23p0 * n_out8p1;


// BooleanParameter:18
	bool n_out18p0 = Has_mask;


	vec4 n_out16p0;
// Texture2D:16
	n_out16p0 = texture(Mask, UV);
	float n_out16p1 = n_out16p0.r;


// FloatConstant:19
	float n_out19p0 = 1.000000;


	bool n_out17p0;
// Switch:17
	if (n_out18p0) {
		n_out17p0 = n_out16p1 > 0.0 ? true : false;
	} else {
		n_out17p0 = n_out19p0 > 0.0 ? true : false;
	}


// FloatOp:11
	float n_out11p0 = n_out24p0 * (n_out17p0 ? 1.0 : 0.0);


// Fresnel:28
	float n_in28p3 = 10.00000;
	float n_out28p0 = pow(1.0 - clamp(dot(NORMAL, VIEW), 0.0, 1.0), n_in28p3);


// FloatOp:29
	float n_out29p0 = n_out11p0 + n_out28p0;


// Output:0
	ALBEDO = vec3(n_out27p0.xyz);
	ALPHA = n_out29p0;


}
"
