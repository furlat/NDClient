options = {"bounded_formation": false, "qualification": "native_family_port_candidate; selected production phase equivalence pending", "registration_note": "Original Chill necrotic hand treatment on the recovered DemonPunch source, retaining the requested portal, emerging punch, original smoke and full native lifecycle. Reuse recipes/spells/chill_touch.json -> chill_hand.gd green()/recolor_source(). The copied source_materials_only option bypasses export recentering/rotation, hand/puff enlargement and tick cutoff. Explicit layers=0 restores the original Chill exclusions for debirs_mini_FINAL, debirs_mini_A, SmCrackaura1998, Decal, muzzle2start and muzzle2end: donor ground-slam debris/cracks and portal starbursts obscure the selected spell composition. Portal is the deliberate restored exception requested for the emerging hand. Native punch scale6 is unchanged; staging applies source X90 and recipient-sized world scale once.", "property_overrides": [{"node": "effect/Donor/muzzle", "property": "material_override:no_depth_test", "value": false}, {"node": "effect/Donor/debirs_mini_FINAL", "property": "layers", "value": 0}, {"node": "effect/Donor/debirs_mini_A", "property": "layers", "value": 0}, {"node": "effect/Donor/SmCrackaura1998", "property": "layers", "value": 0}, {"node": "effect/Donor/Decal", "property": "layers", "value": 0}, {"node": "effect/Donor/muzzle2start", "property": "layers", "value": 0}, {"node": "effect/Donor/muzzle2end", "property": "layers", "value": 0}], "depth_note": "The source muzzle intentionally draws through geometry; the sandbox enables its normal native depth test for scene occlusion. Recovered spectral hand material receives the original Chill necrotic recolouring before animation sampling.", "stage": "impact"}
