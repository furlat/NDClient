code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_disabled, diffuse_lambert, specular_schlick_ggx, unshaded, shadows_disabled;

uniform sampler2D Hit_texture : source_color;
uniform sampler2D depth_tex_frg_6 : hint_depth_texture;



void vertex() {
// GetBillboardMatrix:2
	// Node is disabled and code is not generated.
}

void fragment() {
// Input:2
	vec4 n_out2p0 = COLOR;
	float n_out2p4 = n_out2p0.a;


	vec4 n_out4p0;
// Texture2D:4
	n_out4p0 = texture(Hit_texture, UV);
	float n_out4p1 = n_out4p0.r;


// FloatOp:5
	float n_out5p0 = n_out4p1 * n_out2p4;


	float n_out6p0;
// ProximityFade:6
	float n_in6p0 = 0.20000;
	{
		float __depth_tex = texture(depth_tex_frg_6, SCREEN_UV).r;
		vec4 __depth_world_pos = INV_PROJECTION_MATRIX * vec4(SCREEN_UV * 2.0 - 1.0, __depth_tex, 1.0);
		__depth_world_pos.xyz /= __depth_world_pos.w;
		n_out6p0 = clamp(1.0 - smoothstep(__depth_world_pos.z + n_in6p0, __depth_world_pos.z, VERTEX.z), 0.0, 1.0);
	}


// FloatOp:7
	float n_out7p0 = n_out5p0 * n_out6p0;


// Output:0
	ALBEDO = vec3(n_out2p0.xyz);
	ALPHA = n_out7p0;


}
"
