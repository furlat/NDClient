[resource]
code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_lambert, specular_schlick_ggx;

uniform vec2 Scale = vec2(1.000000, 1.000000);
uniform vec2 Speed_XY;
uniform sampler2D Color_Texture : source_color, repeat_enable;
uniform vec4 ColorParameter : source_color = vec4(1.000000, 1.000000, 1.000000, 1.000000);
uniform float Opacity : hint_range(0, 1) = 1;
uniform sampler2D Dissolver_Texture : source_color, hint_default_black, repeat_enable;
uniform sampler2D Metallic_Texture : source_color, repeat_disable;
uniform sampler2D Texture_Roughtness : source_color, repeat_enable;
uniform sampler2D Roughtness_1D_Gradient : source_color, repeat_disable;
uniform sampler2D Normal_Texture : hint_normal, repeat_enable;
uniform float Normal_Map_Depth = 1;



void vertex() {
// GetBillboardMatrix:2
	// Node is disabled and code is not generated.
}

void fragment() {
// Vector2Parameter:16
	vec2 n_out16p0 = Scale;


// UVFunc:15
	vec2 n_in15p2 = vec2(0.00000, 0.00000);
	vec2 n_out15p0 = (UV - n_in15p2) * n_out16p0 + n_in15p2;


// Vector2Parameter:21
	vec2 n_out21p0 = Speed_XY;


// Input:31
	float n_out31p0 = TIME;


// VectorOp:32
	vec2 n_out32p0 = n_out21p0 * vec2(n_out31p0);


// UVFunc:20
	vec2 n_in20p1 = vec2(1.00000, 1.00000);
	vec2 n_out20p0 = n_out32p0 * n_in20p1 + n_out15p0;


	vec4 n_out10p0;
// Texture2D:10
	n_out10p0 = texture(Color_Texture, n_out20p0);
	float n_out10p4 = n_out10p0.a;


// ColorParameter:40
	vec4 n_out40p0 = ColorParameter;


// VectorOp:35
	vec3 n_out35p0 = vec3(n_out10p0.xyz) * vec3(n_out40p0.xyz);


// FloatParameter:46
	float n_out46p0 = Opacity;


	vec4 n_out42p0;
// Texture2D:42
	n_out42p0 = texture(Dissolver_Texture, UV);
	float n_out42p1 = n_out42p0.r;


// SmoothStep:43
	float n_in43p1 = 1.00000;
	float n_out43p0 = smoothstep(n_out42p1, n_in43p1, n_out10p4);


// FloatOp:45
	float n_out45p0 = n_out46p0 * n_out43p0;


// Reroute:28
	vec2 n_out28p0 = n_out20p0;


	vec4 n_out26p0;
// Texture2D:26
	n_out26p0 = texture(Metallic_Texture, n_out28p0);
	float n_out26p1 = n_out26p0.r;


	vec4 n_out25p0;
// Texture2D:25
	n_out25p0 = texture(Texture_Roughtness, n_out28p0);
	float n_out25p1 = n_out25p0.r;


	vec4 n_out34p0;
// Texture2D:34
	n_out34p0 = texture(Roughtness_1D_Gradient, vec2(n_out25p1));
	float n_out34p1 = n_out34p0.r;


// FloatConstant:44
	float n_out44p0 = 0.500000;


	vec4 n_out23p0;
// Texture2D:23
	n_out23p0 = texture(Normal_Texture, n_out28p0);


// FloatParameter:37
	float n_out37p0 = Normal_Map_Depth;


// Output:0
	ALBEDO = n_out35p0;
	ALPHA = n_out45p0;
	METALLIC = n_out26p1;
	ROUGHNESS = n_out34p1;
	SPECULAR = n_out44p0;
	NORMAL_MAP = vec3(n_out23p0.xyz);
	NORMAL_MAP_DEPTH = n_out37p0;


}
