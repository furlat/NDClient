code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_disabled, diffuse_lambert, specular_schlick_ggx, unshaded;

uniform sampler2D curve_frg_80 : repeat_disable;
uniform vec2 Speed = vec2(0.000000, -1.000000);
uniform sampler2D Texture2DParameter : repeat_enable;
uniform sampler2D Texture2DParameter2;



void fragment() {
// Input:32
	vec4 n_out32p0 = COLOR;


// VectorDecompose:33
	float n_out33p0 = n_out32p0.x;
	float n_out33p1 = n_out32p0.y;
	float n_out33p2 = n_out32p0.z;
	float n_out33p3 = n_out32p0.w;


// FloatFunc:61
	float n_out61p0 = 1.0 - n_out33p0;


// CurveTexture:80
	float n_out80p0 = texture(curve_frg_80, vec2(n_out61p0)).r;


	float n_out75p0;
// Remap:75
	float n_in75p1 = 0.00000;
	float n_in75p2 = 1.00000;
	float n_in75p3 = 0.00000;
	float n_in75p4 = 0.70000;
	{
		float __input_range = n_in75p2 - n_in75p1;
		float __output_range = n_in75p4 - n_in75p3;
		n_out75p0 = n_in75p3 + __output_range * ((n_out80p0 - n_in75p1) / __input_range);
	}


// Input:69
	float n_out69p0 = TIME;


// Vector2Parameter:76
	vec2 n_out76p0 = Speed;


// VectorOp:70
	vec2 n_out70p0 = vec2(n_out69p0) * n_out76p0;


// UVFunc:68
	vec2 n_in68p1 = vec2(1.00000, 1.00000);
	vec2 n_out68p0 = n_out70p0 * n_in68p1 + UV;


	vec4 n_out43p0;
// Texture2D:43
	n_out43p0 = texture(Texture2DParameter, n_out68p0);


// SmoothStep:62
	float n_in62p1 = 0.70000;
	float n_out62p0 = smoothstep(n_out75p0, n_in62p1, n_out43p0.x);


	vec4 n_out78p0;
// Texture2D:78
	n_out78p0 = texture(Texture2DParameter2, vec2(n_out62p0));


// Output:0
	ALBEDO = vec3(n_out78p0.xyz);
	ALPHA = n_out62p0;


}
"
