input = {"source_material": "res://assets/vfx/sources/e8ac042cb6e506bb84bc/m_ice_spikes_I1.tres", "source_snapshot_seconds": 0.8, "source_flow_span_seconds": 0.18, "alpha_gain": 0.22, "uniforms": {"ColorIntensity": 1.05, "BreakFactorGlobal": 0.0, "Details_speed": {"type": "Vector2", "value": [0, 0.05]}}, "source_fragment_finish": "\n// Native Ice Storm frost_mass/frost_detail source response: retain fine donor output while giving the frost a readable blue body.\nfloat recipient_frost_grain=texture(AddTexture2,UV*vec2(2.3,2.7)).r;\nvec3 recipient_frost_body=texture(Color1DGradient,vec2(.35+.20*recipient_frost_grain,.5)).rgb;\nALBEDO=mix(ALBEDO,recipient_frost_body*.90,.65);\n", "_prepared_materials": [{"key": "12b005300ba89423666c6e60d230c3cce7103c174ae540e0b902b476a7f51670", "path": "res://assets/vfx/sources/fc4f69a1298a8f2cfe7c/12b005300ba89423666c6e60d230c3cce7103c174ae540e0b902b476a7f51670.res"}]}
