options = {"bounded_formation": false, "qualification": "native_family_port_candidate; selected production phase equivalence pending", "stage": "travel", "registration_note": "Original uniformly scaled IceLance geometry, snow texture, HDR gradient and width curve. Only released flight records ribbon history, with its UV clock independent of the retimed FlightLight. Selected native length_seconds is 0.12 (9 slots at 75 Hz): the donor 0.56-second history spanned 4.48 cells at the sandbox default 8 cells/s, tethering the 0.59-cell knife to the hand; the selected history spans 0.96 cell at that speed. This is explicit sandbox trail-duration authoring, not a source alpha repair.", "motion_trails": ["effect/Donor/GPUTrail3D"], "property_overrides": [{"node": "effect/Donor/GPUTrail3D", "property": "length_seconds", "value": 0.12}]}
