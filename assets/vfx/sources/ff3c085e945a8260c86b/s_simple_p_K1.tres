[resource]
code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_lambert, specular_schlick_ggx, unshaded, fog_disabled;

uniform vec2 Speed_Multiplier;
uniform sampler2D Mask_Texture : source_color, hint_default_black, filter_linear, repeat_disable;



void fragment() {
// Input:4
	vec4 n_out4p0 = COLOR;
	float n_out4p4 = n_out4p0.a;


// Vector2Parameter:6
	vec2 n_out6p0 = Speed_Multiplier;


// VectorOp:7
	vec2 n_out7p0 = n_out6p0 * vec2(n_out4p4);


// UVFunc:5
	vec2 n_in5p1 = vec2(1.00000, 1.00000);
	vec2 n_out5p0 = n_out7p0 * n_in5p1 + UV;


	vec4 n_out3p0;
// Texture2D:3
	n_out3p0 = texture(Mask_Texture, n_out5p0);
	float n_out3p1 = n_out3p0.r;


// Output:0
	ALBEDO = vec3(n_out4p0.xyz);
	ALPHA = n_out3p1;


}
"
