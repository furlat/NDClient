[resource]
script = ExtResource("1_ikeav")
id = "action.class.cleric.divine_intervention.golden_generosity"
kind = "action"
family = "class"
icon = SubResource("Resource_6pyok")
body = SubResource("Resource_gfrmu")
effect_sources = PackedStringArray()
effects = Array[ExtResource("factory_effect_use")]([SubResource("FactoryInvocation"), SubResource("FactoryObservedResult")])
status = "partial"
notes = "Exact Factory invocation and admission accent are driven by native descendants and immutable event-time after-values. Actual item/container UUID stays separate from character geometry. No review item, placement, outcome or visual approval is inferred; held-item position is the authored actual holder socket, placed-container position is canonical base elevation."
