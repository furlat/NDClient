[sub_resource type="Resource" id="Resource_gfrmu"]
script = ExtResource("1_caayn")
role = "cast_alt"
enabled = false
hidden_slots = PackedStringArray()

[sub_resource type="Resource" id="Resource_6pyok"]
script = ExtResource("2_gfrmu")
path = "art/media/ui/icons/smooth48/ui.filter-actions.png"
native_size = Vector2i(48, 48)
reuses = "ui.filter-actions"
status = "stand_in"
source = "ui/resources.json icon:ui.filter-actions"

[sub_resource type="Resource" id="FactoryInvocation"]
