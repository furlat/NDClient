[resource]
script = ExtResource("1_pqerx")
id = "action.class.cleric.divine_intervention.sunder_heretical"
kind = "action"
family = "class"
icon = SubResource("Resource_ls105")
body = SubResource("Resource_2hllm")
effect_sources = PackedStringArray()
effects = Array[ExtResource("factory_effect_use")]([SubResource("FactoryInvocation"), SubResource("FactoryObservedResult")])
status = "partial"
notes = "Body role from the server's body kind (self_ability); the rig resolves it to a clip once roles are built (coverage fill). Exact Factory source invocation is bound to the disclosed action. Recipient output stays an explicit observed_damage_result_not_qualified gap; no sample damage, item UUID, creation position or visual approval is inferred."
