[resource]
script = ExtResource("1_0hyaw")
id = "action.class.paladin.lay_on_hands"
kind = "action"
family = "class"
icon = SubResource("Resource_b6q1d")
body = SubResource("Resource_607u5")
effects = Array[ExtResource("effect")]([SubResource("CommittedHealing"), SubResource("CommittedCure")])
effect_sources = PackedStringArray()
notes = "One chosen existing healing artwork serves all actual positive unblocked Lay on Hands healing, without inferring Lesser/Greater from amount. Actual same-action condition removals select the separate Cure artwork. Greater is an unselected artwork alternative, not a required missing gameplay form. Fixture leases/events are cleared and exact native outcomes bind each finite source; no extra casting body or windup is invented. Native visual acceptance remains open."
