[sub_resource type="Resource" id="ActualPortableFreezingBlast"]
script = ExtResource("event_family")
clip = "high-level-22/freezing-sphere/launch_blast"
source_phase = ExtResource("public_explosion")
source_inputs = Dictionary[String, String]({"observed_explosion":"set_observed_explosion", "targets":"set_targets"})
