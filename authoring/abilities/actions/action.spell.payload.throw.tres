scope = "cast"
at = "event.start"
attachment = "caster_ground"
orientation = "world"
source_end = 1.2
duration_policy = "authored"
constructor_input = {"kind":"observed_event", "projection":"portable_payload_blast", "outcome":"cast", "geometry_actor":"caster", "component_path":["effect"], "input_field":"", "behavior_id":"action.spell.payload.throw", "explosion_behavior_id":"action.spell.payload.throw", "payload_kind":"freezing", "area_shape":"sphere", "area_propagation":"line_of_effect"}
extra = {"live_endpoints":[{"cue_point":"source"}]}
staging_from = "factory@runtime-public-admission-20261020-976f8289ebcefa5c; actual public finite explosion, independent of retained/private item ownership."

[resource]
script = ExtResource("1_jhau2")
id = "action.spell.payload.throw"
kind = "action"
family = "spell"
icon = SubResource("Resource_7gwy4")
body = SubResource("Resource_5vs71")
effect_sources = PackedStringArray()
effects = Array[ExtResource("event_family")]([SubResource("Resource_event_family_0"), SubResource("Resource_event_family_1"), SubResource("ActualPortableFreezingBlast")])
notes = "Actual public Freezing explosion uses its completed native spell occurrence and linked completed accepted throw, public sphere origin/resolved cells and real target support. Both independent seats can render it without another seat's inventory or lifetime. The original caster remains distinct from the acting thrower. The source discriminator rejects the connected Delayed Fireball branch; its existing finite recipient result contacts remain separately authored. Direct-launch and retained-item Freezing sources keep their existing strict gates. All artwork is unreviewed; production native output/readiness qualification remains separate."
status = "partial"
