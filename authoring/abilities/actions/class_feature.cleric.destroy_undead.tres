[gd_resource type="Resource" script_class="PresentationAction" format=3]

[ext_resource type="Script" path="res://presentation/source/abilities/action.gd" id="action"]
[ext_resource type="Script" path="res://presentation/source/effect_use.gd" id="effect"]

[ext_resource type="Script" path="res://presentation/source/image_ref.gd" id="image"]

[sub_resource type="Resource" id="PendingFeatureArtwork"]
script = ExtResource("image")
path = "art/media/ui/icons/smooth48/ui.filter-actions.png"
native_size = Vector2i(48, 48)
reuses = "ui.filter-actions"
status = "stand_in"
source = "Existing UI category glyph; dedicated passive-feature artwork is missing."

[sub_resource type="Resource" id="ObservedPassiveResult"]
script = ExtResource("effect")
clip = "divine-class-study/divine_destroy_undead_study/0-destroy"
selection = "divine_destroy_undead_study"
role = "attached"
scope = "recipient"
constructor_input = {
 "kind": "observed_event",
 "outcome": "damage",
 "component_path": [
  "divine_art"
 ],
 "geometry_actor": "target",
 "damage_type": "Radiant"
}
endpoint_actor_uuids = true
at = "event.start"
attachment = "recipient_ground"
orientation = "world"
source_end = 0.75
duration_policy = "authored"
fade_out = 0.18
light_multiplier = 0.0
unbound_constructor_inputs = PackedStringArray("effective_handler_attribution")
staging_from = "factory@production-bindings-c494177f9ef03e3d selection:divine_destroy_undead_study"
extra = {
 "dynamic_geometry": true,
 "entity_geometry": {
  "actor": "target",
  "slots": [
   "body",
   "chest",
   "legs",
   "head",
   "helmet",
   "boots",
   "gauntlets",
   "belt",
   "cloak"
  ]
 },
 "follow_attachment": true,
 "live_endpoints": [
  {
   "actor": "caster",
   "socket": "cast_hand"
  },
  {
   "actor": "caster",
   "socket": "face",
   "pose_socket": "head"
  },
  {
   "actor": "target",
   "socket": "body_center"
  }
 ],
 "to_actor": "target",
 "required_effective_handler": "class_feature.cleric.destroy_undead"
}

[resource]
script = ExtResource("action")
id = "class_feature.cleric.destroy_undead"
kind = "class_feature"
family = "class"
icon = SubResource("PendingFeatureArtwork")
disposition = "authored"
effects = Array[ExtResource("effect")]([SubResource("ObservedPassiveResult")])
status = "partial"
notes = "Exact frozen native passive handler; not a standalone action. Factory contact source remains missing until observed handler attribution and its own accepted result can be joined. No name-based damage/heal inference, fake ActionFact, generic icon, or user visual approval. Destroy Undead markers, where present in the study, remain with the real Turned lifecycle."
