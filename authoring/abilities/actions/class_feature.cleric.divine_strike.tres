[gd_resource type="Resource" script_class="PresentationAction" format=3]

[ext_resource type="Script" path="res://presentation/source/abilities/action.gd" id="action"]
[ext_resource type="Script" path="res://presentation/source/effect_use.gd" id="effect"]

[ext_resource type="Script" path="res://presentation/source/image_ref.gd" id="image"]

[sub_resource type="Resource" id="PendingFeatureArtwork"]
script = ExtResource("image")
path = "art/media/ui/icons/smooth48/ui.filter-actions.png"
native_size = Vector2i(48, 48)
reuses = "ui.filter-actions"
status = "stand_in"
source = "Existing UI category glyph; dedicated passive-feature artwork is missing."

[sub_resource type="Resource" id="ObservedPassiveResult"]
script = ExtResource("effect")
clip = "divine-class-study/divine_divine_strike_study/0-strike"
selection = "divine_divine_strike_study"
role = "attached"
scope = "cast"
constructor_input = {"kind": "observed_event", "projection": "weapon_component", "packet": "event", "outcome": "damage", "geometry_actor": "target", "damage_type": "Radiant", "damage_source_ids": ["class_feature.cleric.divine_strike"], "component_path": ["divine_art"], "input_field": ""}
endpoint_actor_uuids = true
at = "event.start"
attachment = "recipient_ground"
orientation = "world"
source_end = 0.55
duration_policy = "authored"
fade_out = 0.18
light_multiplier = 0.0
staging_from = "factory@production-bindings-c494177f9ef03e3d selection:divine_divine_strike_study"
extra = {
 "dynamic_geometry": true,
 "entity_geometry": {
  "actor": "target",
  "slots": [
   "body",
   "chest",
   "legs",
   "head",
   "helmet",
   "boots",
   "gauntlets",
   "belt",
   "cloak"
  ]
 },
 "follow_attachment": true,
 "live_endpoints": [
  {
   "actor": "caster",
   "socket": "cast_hand"
  },
  {
   "actor": "caster",
   "socket": "face",
   "pose_socket": "head"
  },
  {
   "actor": "target",
   "socket": "body_center"
  }
 ],
 "to_actor": "target",
 "required_effective_handler": "class_feature.cleric.divine_strike"
}

[resource]
script = ExtResource("action")
id = "class_feature.cleric.divine_strike"
kind = "class_feature"
family = "class"
icon = SubResource("PendingFeatureArtwork")
disposition = "authored"
effects = Array[ExtResource("effect")]([SubResource("ObservedPassiveResult")])
status = "partial"
notes = "Actual equipped Hit/Crit and exact public attributed Radiant source_damage_uuid select this finite event phase. The enclosing positive applied packet supplies the event witness without inventing an independent HP allocation or standalone feature action. Review event/lease packets are cleared. All artwork remains unreviewed; native qualification is separate."
