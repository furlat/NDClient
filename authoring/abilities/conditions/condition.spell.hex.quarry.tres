[gd_resource type="Resource" script_class="PresentationCondition" format=3]

[ext_resource type="Script" path="res://presentation/source/image_ref.gd" id="1_byfpx"]
[ext_resource type="Script" path="res://presentation/source/abilities/condition.gd" id="1_gtl85"]

[ext_resource type="Script" path="res://presentation/source/effect_use.gd" id="quarry_use"]

[sub_resource type="Resource" id="Resource_a3nnr"]
script = ExtResource("1_byfpx")
path = "art/ui-delivery-20261018/runtime/smooth48/spell.hex.png"
native_size = Vector2i(48, 48)
reuses = "spell.hex"
status = "stand_in"
source = "ui-delivery-20261018"

[sub_resource type="Resource" id="ActualQuarryOwner"]
script = ExtResource("quarry_use")
clip = "bg3-36/hex/hex_native/condition"
role = "attached"
scope = "source"
at = "owner_start"
attachment = "recipient_ground"
orientation = "world"
constructor_input = {"kind": "quarry_owner", "quarry_kind": "hex", "component_path": ["owned_quarry"], "input_field": "", "owner_condition_id": "condition.spell.hex", "recipient_condition_id": "condition.spell.hex.quarry"}
extra = {"entity_geometry": {"actor": "target", "slots": ["body", "chest", "head", "legs"]}, "live_endpoints": [{"actor": "target", "socket": "body_center"}, {"actor": "target", "socket": "body_center", "surface_slots": ["body", "chest", "cloak", "legs", "head", "helmet", "hands", "shoes"]}], "input_policies": {"healing_input": {"mode": "not_applicable", "reason": "selected_quarry_condition_consumes_actual_owner_and_quarry_state"}, "strike_input": {"mode": "not_applicable", "reason": "selected_quarry_condition_consumes_actual_owner_and_quarry_state"}, "condition_input": {"mode": "not_applicable", "reason": "selected_quarry_condition_consumes_actual_owner_and_quarry_state"}, "tick_input": {"mode": "not_applicable", "reason": "selected_quarry_condition_consumes_actual_owner_and_quarry_state"}, "hit_input": {"mode": "not_applicable", "reason": "selected_quarry_condition_consumes_actual_owner_and_quarry_state"}}}

[resource]
script = ExtResource("1_gtl85")
id = "condition.spell.hex.quarry"
icon = SubResource("Resource_a3nnr")

disposition = "authored"
effects = Array[ExtResource("quarry_use")]([SubResource("ActualQuarryOwner")])
status = "partial"
notes = "Actual original cast joins exact public caster sustain and recipient child. Current state controls membership and suppression; no retained fixture lifetime, inferred damage or private owner. Finite attributed contacts and reapply are separately authored."
