}
staging_from = "factory@c494177f9ef03e3d"
extra = {
"live_endpoints": [{"cue_point": "source"}],
"cell_capacity": 32
}

[resource]
script = ExtResource("spatial_owner")
id = "spatial_effect.material.fire"
disposition = "authored"
effects = Array[ExtResource("spatial_effect_use")]([SubResource("ObservedSurface")])
status = "partial"
notes = "Exact sealed observed-surface source, owned by the actual disclosed spatial UUID/cells/suppression. Fixture topology/presence and three-second retirement are cleared before construction. No caster, condition fact, damage or duration is inferred. Original source supports at most 32 admitted cells; larger owners remain an explicit capacity gap. Removal follows actual disclosure immediately; native fading and visual approval remain unqualified."
