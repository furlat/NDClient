[gd_resource type="Resource" script_class="PresentationCondition" format=3]

[ext_resource type="Script" path="res://presentation/source/abilities/condition.gd" id="spatial_owner"]
[ext_resource type="Script" path="res://presentation/source/effect_use.gd" id="spatial_effect_use"]

[sub_resource type="Resource" id="ObservedSurface"]
script = ExtResource("spatial_effect_use")
clip = "bg3-36/chromatic-orb/fire/observed-surface"
role = "attached"
scope = "spatial"
at = "owner_start"
attachment = "recipient_ground"
