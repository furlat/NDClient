[resource]
script = ExtResource("1_cabyx")
id = "spatial_effect.spell.antilife_shell"
disposition = "authored"
play_package_lifecycle = false
effects = Array[ExtResource("effect")]([SubResource("ActualShell")])
icon = SubResource("Resource_gu4uh")

status = "partial"
notes = "The actual disclosed Antilife spatial UUID and current anchor own the existing ten-foot shell. Constructor projection replaces the fixture owner/state and clears its review_states retirement; the existing owner_state setter receives only this real current spatial membership/admission. The 3.9-second source inspection does not expire the native owner. Actual disappearance or retirement removes the shell; no crossing, living-type, collision or timer rule is evaluated by the client. No separate finite cast shell is replayed. All artwork is unreviewed."
