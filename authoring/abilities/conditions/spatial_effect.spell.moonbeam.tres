[sub_resource type="Resource" id="RetainedBeam"]
script = ExtResource("effect")
clip = "bg3-36/moonbeam/hold"
approach = "native"
role = "attached"
scope = "spatial"
at = "owner_start"
attachment = "recipient_ground"
orientation = "world"
source_end = 4.0
light_multiplier = 0.0
extra = {"live_endpoints": [{"cue_point": "source"}]}

[resource]
script = ExtResource("1_gogrx")
id = "spatial_effect.spell.moonbeam"
disposition = "authored"
play_package_lifecycle = false
effects = Array[ExtResource("effect")]([SubResource("RetainedBeam")])
icon = SubResource("Resource_viy3v")

status = "partial"
notes = "The exact disclosed Moonbeam spatial UUID owns this native continuous hold at its current public anchor and elevation. The source consumes the real endpoint and has no recipient, review trajectory or timed removal packet; its four-second inspection window does not expire the native owner. Actual relocation moves the same source owner. The old fixed cast apply/hold/remove and two review recipient contacts are excluded; real Radiant damage keeps its own receiving feedback. This assignment uses immediate actual owner teardown; bespoke application/removal and finite contact art remain unqualified. All artwork is unreviewed."
