[ext_resource type="Script" path="res://presentation/source/image_ref.gd" id="1_i35dj"]

[ext_resource type="Script" path="res://presentation/source/effect_use.gd" id="effect"]

[sub_resource type="Resource" id="Resource_viy3v"]
script = ExtResource("1_i35dj")
