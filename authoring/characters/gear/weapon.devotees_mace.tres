[gd_resource type="Resource" script_class="PresentationGear" format=3]

[ext_resource type="Script" path="res://presentation/source/image_ref.gd" id="1_mjmim"]
[ext_resource type="Script" path="res://presentation/source/characters/gear.gd" id="2_osjg3"]

[ext_resource type="Script" path="res://presentation/source/effect_use.gd" id="effect"]

[sub_resource type="Resource" id="Resource_qblno"]
script = ExtResource("1_mjmim")
path = "art/media/ui/icons/smooth48/item.mace.png"
native_size = Vector2i(48, 48)
reuses = "item.mace"
source = "ui-icons-bg3-glyphs-2026-10-07"

[sub_resource type="Resource" id="IntrinsicSustain"]
script = ExtResource("effect")
clip = "weapons/equipped/radiant/solar_bevel/medium/sustain"
role = "sustain"
at = "owner_start"
attachment = "recipient_weapon"
recipient_slots = PackedStringArray("weapon")
follow = true
light_multiplier = 0.0
extra = {"equipment_slots": ["weapon_melee_main"]}
staging_from = "Factory exact-item assignment proposal; one medium main-hand candidate. Actual source-mask/pose admission stays authoritative; artistic acceptance pending R8."

[sub_resource type="Resource" id="IntrinsicContact"]
script = ExtResource("effect")
clip = "weapons/contact/radiant/medium"
role = "impact"
at = "body.impact"
attachment = "recipient_body"
follow = false
light_multiplier = 0.0
staging_from = "Factory exact-item contact proposal, once per actual equipped Hit/Crit. No inferred elemental DamageFact or additional lamp. Artistic acceptance pending R8."

[resource]
script = ExtResource("2_osjg3")
id = "weapon.devotees_mace"
effects = Array[ExtResource("effect")]([SubResource("IntrinsicSustain")])
impact_effects = Array[ExtResource("effect")]([SubResource("IntrinsicContact")])
kind = "weapon"
family = "weapon.mace"
icon = SubResource("Resource_qblno")
status = "partial"
notes = "Wielded body uses the authored modular Mace sheets, matching the engine's Mace visual identity. Additional native decoration remains incomplete; the delivered native mace-body replacement is not selected."

# R2 candidate only: retain the original sheet, tint, family, ground art and real item UUID. No source refusal is bypassed.
