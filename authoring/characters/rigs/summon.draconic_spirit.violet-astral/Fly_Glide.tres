name = "Fly_Glide"
role = "flight_glide"
source_clip = "Fly_Glide"
frames = 16
fps = 12.0
loop = "loop"
body_banks = Dictionary[String, ExtResource("art")]({"E": SubResource("art_E"), "SE": SubResource("art_SE"), "S": SubResource("art_S"), "SW": SubResource("art_SW"), "W": SubResource("art_W"), "NW": SubResource("art_NW"), "N": SubResource("art_N"), "NE": SubResource("art_NE")})
notes = "Native source poses retained exactly. Review clock12fps; vendor clock unknown. No event contact/release markers inferred. All art UNREVIEWED."
