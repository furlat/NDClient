[resource]
script = ExtResource("rig")
id = "summon.elemental.earth"
pack = "elementals"
variant = "Earth"
source = "summon-elemental-production-v1/2026-10-21-final-air-continuous"
cell = Vector2i(192, 192)
pivot = Vector2(96, 138)
anchor = Vector2(96.0, 113.0)
camera_elevation_degrees = 30.0
direction_order = PackedStringArray("E", "SE", "S", "SW", "W", "NW", "N", "NE")
slot_order = PackedStringArray("body")
slot_categories = Dictionary[String, PackedStringArray]({"body": PackedStringArray("ElementalEarth")})
clips = Array[ExtResource("clip")]([SubResource("clip_Idle"), SubResource("clip_Walk"), SubResource("clip_AttackHeavy"), SubResource("clip_Hit"), SubResource("clip_Death"), SubResource("clip_Attack"), SubResource("clip_Jab"), SubResource("clip_Hook"), SubResource("clip_Cast")])
fallbacks = Dictionary[String, String]({"Attack1": "Attack", "Attack2": "AttackHeavy", "Attack3": "Jab", "Attack4": "Hook", "Die": "Death", "TakeDamage": "Hit", "Run": "Walk", "Rolling": "Walk", "CrouchWalk": "Walk", "Idle2": "Idle", "Special1": "Cast"})
contexts = Array[ExtResource("context")]([SubResource("context_0"), SubResource("context_1"), SubResource("context_2"), SubResource("context_3")])
shadow = "generated"
hold_clips = PackedStringArray("Death", "Die")
status = "partial"
notes = "Delivered9 native actions,8facings,15frames12fps; fixed192cell/contact96,138/elevation30 and raw affine-depth/optical-normal/support companions. No contact/release/mouth/hand socket is authored. Standard missing role names explicitly alias compatible source clips; flying holds the existing Idle body and no dedicated flying/melee/swimming pose is asserted. Earth/Water retain final debris/puddle; Fire/Air finish clear. Original-only normal profile; requested absent profiles retain existing admission refusal. Placement/scale/native output and all artwork remain unreviewed."
