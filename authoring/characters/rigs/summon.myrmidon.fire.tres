[resource]
script = ExtResource("rig")
id = "summon.myrmidon.fire"
pack = "myrmidons"
variant = "FireMyrmidon"
source = "elemental-expansion-2026-10-22-v1"
cell = Vector2i(192, 192)
pivot = Vector2(96, 138)
anchor = Vector2(96.0, 112.75)
camera_elevation_degrees = 30.0
direction_order = PackedStringArray("E", "SE", "S", "SW", "W", "NW", "N", "NE")
slot_order = PackedStringArray("body")
slot_categories = Dictionary[String, PackedStringArray]({"body": PackedStringArray("FireMyrmidon")})
clips = Array[ExtResource("clip")]([SubResource("clip_Idle"), SubResource("clip_Walk"), SubResource("clip_AttackHeavy"), SubResource("clip_Hit"), SubResource("clip_Death"), SubResource("clip_Attack"), SubResource("clip_Jab"), SubResource("clip_Hook"), SubResource("clip_Cast")])
fallbacks = Dictionary[String, String]({"Attack1": "Attack", "Attack2": "AttackHeavy", "Attack3": "Jab", "Attack4": "Hook", "Die": "Death", "TakeDamage": "Hit", "Run": "Walk", "Rolling": "Walk", "CrouchWalk": "Walk", "Idle2": "Idle", "Special1": "Cast"})
contexts = Array[ExtResource("context")]([SubResource("context_0"), SubResource("context_1"), SubResource("context_2"), SubResource("context_3")])
shadow = "generated"
hold_clips = PackedStringArray("Death", "Die")
status = "partial"
notes = "Own equipped Myrmidon body: all9 actual source bank names,8directions,15frames12fps and fixed192cell/contact96,138/elevation30. Raw source colour is unchanged; compatibility affine-depth/optical-normal/support derives only from actual canonical geometry. Original-only profile and ground0 are explicit. The generic body-effect anchor is the median centre of120 Idle alpha bounds, not sprite registration, a hand/head/mouth socket or an event marker. Native source motion aliases remain the delivered per-action source records; no bank is collapsed from summary prose. Existing role fallbacks are explicit; no flying attack, jump, swimming or contact/release timestamp is invented. Death holds actual supplied final pixels, including equipment/debris where present. The equipped weapon is baked body artwork; its part masks are not a selected weapon-only VFX receiver. Mechanical size/occupancy and actor visual scale remain authoritative. Native output, placement and all art/audio remain unreviewed."
