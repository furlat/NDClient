[resource]
script = ExtResource("3_31cyj")
id = "environment.trap_lever"
kind = "lever"
views = PackedStringArray("e", "n", "s", "w")
select_field = "is_engaged"
states = Dictionary[String, ExtResource("4_jp6af")]({
"false": SubResource("states_false"),
"true": SubResource("states_true")
})
transitions = Array[ExtResource("5_n2qeu")]([SubResource("transitions_0"), SubResource("transitions_1")])
art = PackedStringArray()
status = "ready"
notes = "The lever snaps between its poses; the 24 fps transition is data only (also duplicated in the old catalog/world_animations.json)."
