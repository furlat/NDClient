[gd_resource type="Resource" script_class="PresentationTerrain" format=3]

[ext_resource type="Script" path="res://presentation/source/sound_ref.gd" id="1_ym4ss"]
[ext_resource type="Script" path="res://presentation/source/environment/terrain.gd" id="2_wuv50"]
[ext_resource type="Script" path="res://presentation/source/environment/terrain_slope.gd" id="3_v6slu"]

[sub_resource type="Resource" id="footstep"]
script = ExtResource("1_ym4ss")
