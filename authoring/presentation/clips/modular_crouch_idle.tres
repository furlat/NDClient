[gd_resource type="Resource" script_class="PresentationBodyClip" load_steps=2 format=3]

[ext_resource type="Script" path="res://presentation/resources/body_clip.gd" id="1"]

; Existing source-only sheet: 15 native 128px cells x 8 facing rows.
; Source delivery has no FPS. 12 FPS is a new client authoring choice,
; matching the existing modular clips; source pixels/registration are unchanged.
[resource]
script = ExtResource("1")
rig_id = "neuroclient.modular"
clip = "CrouchIdle"
source_clip = "CrouchIdle"
frame_count = 15
fps = 12.0
